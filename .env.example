# Default: run a local model with Ollama. No API key required.
AI_PROVIDER=ollama
AI_MODEL=llama3.2:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: use any OpenAI-compatible cloud provider instead.
# Set AI_PROVIDER=openai-compatible, then uncomment and configure these values.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=put-your-secret-key-here
