# Supabase project settings (Project URL + publishable/anon key only).
# Never put a service-role key in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-side AI settings. Default: local Ollama (no API key).
AI_PROVIDER=ollama
AI_MODEL=llama3.2:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional OpenAI-compatible provider:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=put-your-secret-key-here
